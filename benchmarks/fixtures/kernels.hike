package main

cfunc Add(a int, b int) int {
    return a + b
}

cfunc Fibonacci(n int) int {
    if n < 2 {
        return n
    }
    return Fibonacci(n - 1) + Fibonacci(n - 2)
}

cfunc Checksum(n int, seed int) int {
    value := seed
    for i := 0; i < n; i++ {
        value = (value ^ (value << 5)) + (i ^ (value >> 2))
    }
    return value
}
